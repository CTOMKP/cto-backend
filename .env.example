# CTO Marketplace Backend - Example Environment Variables
# Copy this file to .env and fill in real values for local dev.

REACT_APP_PRIVY_APP_ID=cmgnothn800m9l80c17owsa86
# NO SECRET IN FRONTEND - it's secret for a reason!

# App
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
BACKEND_BASE_URL=http://localhost:3001
KEEP_ALIVE_INTERVAL=180000

# Auth
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
ADMIN_EMAIL=admin@ctomemes.xyz
# This is a bcrypt hash placeholder; replace if you bootstrap an admin
ADMIN_PASSWORD=$2b$10$exampleexampleexampleexampleexampleexamp

# Circle Auth (fill when available)
CIRCLE_ENV=sandbox
CIRCLE_API_KEY=
CIRCLE_WEB_CLIENT_ID=

# Prisma / PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=cto_db
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# Helius & Solana
HELIUS_API_KEY=REPLACE
SOLSCAN_API_KEY=

# Solana payments. Configure both profiles once, then switch only SOLANA_NETWORK.
# In this project, "testnet" operation uses Solana devnet (not the validator stress-test cluster).
SOLANA_NETWORK=devnet
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_DEVNET_USDC_MINT=6e5qtpMzrLzDM8R6fHQtoF6d2iybHBYdj56tceKZo9sn
SOLANA_DEVNET_ADMIN_WALLET=REPLACE_WITH_DEVNET_TREASURY
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_MAINNET_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOLANA_MAINNET_ADMIN_WALLET=REPLACE_WITH_MAINNET_TREASURY
# Exact atomic units; USDC uses 6 decimals. 1000000 = 1 USDC.
SOLANA_LISTING_PAYMENT_AMOUNT=1000000

# Active mascot asset keys. The backend assigns the least-used key and preserves one assignment per user.
# Assets must exist at mascots/TRAITS/<KEY>.png in the configured mascot CDN.
MASCOT_TRAIT_KEYS=ARTIST,ARTIST2,ARTIST3,CTO,CTO2,DEGEN,DEGEN2,DEV,EARLYADT.WHALE,HACKER,HACKER2,HACKER3,HODLER,KOL,MOD,MOD2,MOD3,NEWBIE,SHILLER,VISIONARY,VISIONARY2,WHALE,WHALE2,WHALE3

# Aptos / Panora
APTOS_NETWORK=mainnet
APTOS_FULLNODE_URL=https://api.mainnet.aptoslabs.com/v1
APTOS_INDEXER_URL=https://api.mainnet.aptoslabs.com/v1/graphql
# Use only canonical Aptos token date sources. If unavailable, return N/A.
APTOS_STRICT_DATE=true
# Confidence gate required fields for Aptos scans.
# Allowed: HOLDERS,LIQUIDITY,VOLUME_24H,TOKEN_AGE
# Default behavior uses LIQUIDITY,VOLUME_24H (holders/age are advisory until stronger data sources are added).
APTOS_CONFIDENCE_REQUIRED_FIELDS=LIQUIDITY,VOLUME_24H
# Optional Aptos-specific score threshold override for listing checks (scan/create/publish).
# Example temporary value: 49
APTOS_MIN_QUALIFYING_SCORE=50
# Optional unified Aptos API key used for fullnode + indexer bearer auth
APTOS_API_KEY=
# Optional explicit indexer API key override
APTOS_INDEXER_API_KEY=
# Optional Geomi endpoints / key (when using Aptos Labs Developer Portal)
GEOMI_API_KEY=
GEOMI_FULLNODE_URL=
GEOMI_INDEXER_URL=
# Optional GeckoTerminal API base for Aptos market fallback
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
# Optional CoinGecko market fallback for Aptos volume/market-cap/age enrichment
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
PANORA_BASE_URL=https://api.panora.exchange
PANORA_API_KEY=
PANORA_API_SECRET=

# Contabo VPS (optional file storage)
#CONTABO_HOST=84.54.23.80
#CONTABO_PORT=22
#CONTABO_USERNAME=root
#CONTABO_PASSWORD=
#CONTABO_IMAGE_PATH=/var/www/ctomarketplace.com/images
#CONTABO_BASE_URL=https://ctomarketplace.com/images

# Redis (optional)
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Email (automatic listing lifecycle emails)
EMAIL_ENABLED=false
EMAIL_PROVIDER=sendgrid
EMAIL_FROM="CTO Marketplace <no-reply@ctomarketplace.com>"
EMAIL_REPLY_TO=support@ctomarketplace.com
SENDGRID_API_KEY=
RESEND_API_KEY=
# SES (when EMAIL_PROVIDER=ses)
SES_AWS_REGION=us-east-1
SES_FROM_ARN=
SES_CONFIGURATION_SET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
FRONTEND_BASE_URL=https://www.ctomarketplace.com
